From d570cfff88af002e440dc15c34951e654dded843 Mon Sep 17 00:00:00 2001
From: Steffen Persvold <spersvold@gmail.com>
Date: Sun, 14 Jun 2026 11:37:25 +0200
Subject: [PATCH] dt-bindings: display: add opencores,ocfb binding

Binding for the OpenCores VGA/LCD 2.0 core and register-compatible
derivatives: the control/status register window, an optional scanout
memory-region, the generic big-endian property, and the optional
line-pitch, scan-doubling and programmable-pixel-clock extensions. The
programmable-pixclk PLL is described entirely in the device tree -- its
reference clock, fVCO/fPFD bands and M/N/C divide-counter ranges -- so the
binding is not tied to any one PLL macro.

It also describes the optional "copy-on-flip" extension: a second reg
window for a companion DMA command engine and a third for the VRAM
aperture it copies into, the device-side VRAM base (opencores,vram-base),
and a second interrupt for DMA completion -- when that interrupt is wired
the driver completes flips from it (asynchronous), otherwise it polls.

Signed-off-by: Steffen Persvold <spersvold@gmail.com>
---
 .../bindings/display/opencores,ocfb.yaml      | 202 ++++++++++++++++++
 1 file changed, 202 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/opencores,ocfb.yaml

diff --git a/Documentation/devicetree/bindings/display/opencores,ocfb.yaml b/Documentation/devicetree/bindings/display/opencores,ocfb.yaml
new file mode 100644
index 00000000..3f84ba57
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/opencores,ocfb.yaml
@@ -0,0 +1,202 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/opencores,ocfb.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OpenCores VGA/LCD 2.0 framebuffer
+
+maintainers:
+  - Steffen Persvold <spersvold@gmail.com>
+
+description: >
+  The OpenCores VGA/LCD 2.0 core, and register-compatible derivatives, is a
+  framebuffer with programmable display timing driving an RGB/VGA-style
+  output. Some derivatives implement optional registers that are reserved on
+  the original core; they are described by the optional boolean properties
+  below and are left untouched unless the property is present.
+
+properties:
+  compatible:
+    const: opencores,ocfb
+
+  reg:
+    minItems: 1
+    items:
+      - description: control and status registers (CSR)
+      - description: >
+          VRAM aperture -- the host-visible, write-combining window onto the
+          device-local memory holding the copy-on-flip scanout buffers. Present
+          together with the DMA command engine (third entry).
+      - description: >
+          DMA command engine CSRs. When present, each page flip DMA-copies the
+          host framebuffer into the VRAM aperture and scanout reads from there
+          (copy-on-flip).
+
+  reg-names:
+    minItems: 1
+    items:
+      - const: csr
+      - const: vram
+      - const: dma
+
+  interrupts:
+    minItems: 1
+    items:
+      - description: >
+          Per-frame vsync interrupt, raised at start-of-vblank. Optional; with
+          it the driver delivers vblank events and vblank-synchronised page
+          flips, otherwise page flips complete immediately.
+      - description: >
+          DMA-done interrupt of the copy-on-flip command engine. Optional; when
+          present the driver completes page flips from it (asynchronous), and
+          when absent it polls the copy's fence instead (synchronous).
+
+  clocks:
+    maxItems: 1
+    description: >
+      Reference clock (fIN) for the pixel-clock PLL. Required when
+      opencores,programmable-pixclk is present.
+
+  memory-region:
+    maxItems: 1
+    description: >
+      Reserved memory region (a "shared-dma-pool") the scanout buffers are
+      allocated from. If absent the driver allocates them from the system
+      DMA allocator instead.
+
+  opencores,vbar-offset:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: >
+      Offset, in bytes, subtracted from a host buffer's DMA (CPU-physical)
+      address to translate it into the read master's address space. Use it when
+      that master reaches DRAM through a window that is not 1:1 with the CPU
+      physical address map -- for example a bus window whose addresses are
+      relative to the start of DRAM. For direct scanout it
+      translates the address written to the video base register (VBAR); for
+      copy-on-flip it translates the DMA copy's source address (the scanout base
+      then points into VRAM, see opencores,vram-base). Defaults to 0 (the
+      master's address space matches CPU physical).
+
+  opencores,vram-base:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: >
+      Base address of the VRAM aperture (reg index 1) in the address space of
+      the scanout read master and the DMA write master. The two copy-on-flip
+      scanout buffers sit at this base; the VBAR value and the DMA destination
+      address are formed by adding a buffer's offset within VRAM. Defaults to 0
+      (the masters address VRAM from zero). Only meaningful with the DMA
+      command engine present.
+
+  big-endian:
+    type: boolean
+    description: >
+      The core's registers are accessed big-endian. The OpenCores core can
+      be synthesised either way; absent means native/little-endian.
+
+  opencores,has-pitch:
+    type: boolean
+    description: >
+      The implementation provides the horizontal pitch (line stride) register
+      at offset 0x20, allowing the virtual width to exceed the visible width.
+      On the original core this offset is reserved.
+
+  opencores,has-doublescan:
+    type: boolean
+    description: >
+      The implementation provides hardware scan-doubling, controlled by bit 16
+      of the control register. On the original core this bit is reserved.
+
+  opencores,programmable-pixclk:
+    type: boolean
+    description: >
+      The implementation provides a runtime-programmable pixel-clock PLL,
+      reached through the PLLDIVCNT (0x100) and PLLCTRL (0x104) registers,
+      both reserved on the original core. When present, the driver reprograms
+      the pixel clock on mode set; the reference clock (clocks) and the PLL
+      operating bands below are then required.
+
+  opencores,pll-vco-hz:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 2
+    maxItems: 2
+    description: >
+      VCO operating range of the pixel-clock PLL as <minimum maximum>, in Hz.
+
+  opencores,pll-pfd-hz:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 2
+    maxItems: 2
+    description: >
+      Phase-frequency-detector input range (reference clock divided by the N
+      counter) of the pixel-clock PLL as <minimum maximum>, in Hz.
+
+  opencores,pll-m-range:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 2
+    maxItems: 2
+    description: >
+      Integer range <minimum maximum> of the feedback (multiply) counter M
+      (fVCO = fIN * M / N), set by the PLL macro's counter width.
+
+  opencores,pll-n-range:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 2
+    maxItems: 2
+    description: >
+      Integer range <minimum maximum> of the input divide counter N
+      (minimum >= 1), set by the PLL macro's counter width.
+
+  opencores,pll-c-range:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 2
+    maxItems: 2
+    description: >
+      Integer range <minimum maximum> of the post-scale (output divide)
+      counter C, fOUT = fVCO / C (minimum >= 1), set by the PLL macro's
+      counter width.
+
+  opencores,max-pixclk-hz:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: >
+      Optional upper limit, in Hz, on the pixel clock the driver will program
+      -- the board's HDMI transmitter / output timing budget, which may be
+      lower than the PLL operating bands alone allow. Modes needing a higher
+      clock are rejected. No limit is enforced when absent. Only meaningful
+      with opencores,programmable-pixclk.
+
+required:
+  - compatible
+  - reg
+
+allOf:
+  - if:
+      required:
+        - opencores,programmable-pixclk
+    then:
+      required:
+        - clocks
+        - opencores,pll-vco-hz
+        - opencores,pll-pfd-hz
+        - opencores,pll-m-range
+        - opencores,pll-n-range
+        - opencores,pll-c-range
+
+additionalProperties: false
+
+examples:
+  - |
+    framebuffer@20000000 {
+        compatible = "opencores,ocfb";
+        reg = <0x20000000 0x1000>;
+        clocks = <&pll_refclk>;
+        opencores,has-pitch;
+        opencores,has-doublescan;
+        opencores,programmable-pixclk;
+        opencores,pll-vco-hz = <600000000 3200000000>;
+        opencores,pll-pfd-hz = <10000000 325000000>;
+        opencores,pll-m-range = <4 320>;
+        opencores,pll-n-range = <1 110>;
+        opencores,pll-c-range = <1 510>;
+        opencores,max-pixclk-hz = <165000000>;
+    };
-- 
2.40.1

