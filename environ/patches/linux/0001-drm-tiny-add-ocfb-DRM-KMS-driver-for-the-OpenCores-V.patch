--- /dev/null
+++ b/drivers/gpu/drm/tiny/ocfb-drm.c
@@ -0,0 +1,669 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * DRM/KMS driver for the OpenCores VGA/LCD 2.0 core (ocfb) and register-
+ * compatible derivatives. Optional extensions -- a line-pitch register,
+ * hardware scan doubling, and a runtime-programmable pixel-clock PLL -- are
+ * enabled by optional device-tree properties. Bound via the "opencores,ocfb"
+ * compatible.
+ *
+ * The register definitions are derived from the OpenCores VGA/LCD core and
+ * its fbdev driver (drivers/video/fbdev/ocfb.c) by Stefan Kristiansson.
+ *
+ * The hardware is a single-plane scanout engine: an AXI master DMA-reads a
+ * contiguous framebuffer and drives an RGB/HDMI output with programmable
+ * display timing. There is no overlay, cursor or acceleration, so it maps
+ * onto drm_simple_display_pipe + GEM-DMA, with fbdev emulation bringing the
+ * console back.
+ *
+ * Copyright (C) 2013 Stefan Kristiansson (original fbdev driver)
+ * Copyright (C) 2026 Steffen Persvold <spersvold@gmail.com> (DRM port)
+ */
+
+#include <linux/clk.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_device.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fbdev_dma.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_module.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+
+/* OCFB register map (subset; the OpenCores VGA/LCD core defines the rest) */
+#define OCFB_CTRL	0x000
+#define OCFB_STAT	0x004
+#define OCFB_HTIM	0x008
+#define OCFB_VTIM	0x00c
+#define OCFB_HVLEN	0x010
+#define OCFB_VBARA	0x014
+#define OCFB_PITCH	0x020
+
+#define OCFB_CTRL_VEN	0x00000001 /* Video Enable */
+#define OCFB_CTRL_PC	0x00000800 /* 8-bit Pseudo Color Enable */
+#define OCFB_CTRL_CD8	0x00000000 /* Color Depth 8 */
+#define OCFB_CTRL_CD16	0x00000200 /* Color Depth 16 */
+#define OCFB_CTRL_CD24	0x00000400 /* Color Depth 24 */
+#define OCFB_CTRL_CD32	0x00000600 /* Color Depth 32 */
+#define OCFB_CTRL_VBL8	0x00000180 /* Video memory Burst Length 8 */
+#define OCFB_CTRL_HSL	0x00001000 /* HSync active low */
+#define OCFB_CTRL_VSL	0x00002000 /* VSync active low */
+
+/*
+ * Programmable pixel-clock PLL CSRs (opencores,programmable-pixclk) -- an
+ * optional extension; these offsets are reserved on the original core.
+ */
+#define OCFB_PLLDIVCNT	0x100	/* logical M/N/C divisors */
+#define OCFB_PLLCTRL	0x104	/* reconfigure trigger / status */
+
+#define OCFB_PLLDIVCNT_M_SHIFT	0	/* feedback / multiply  [8:0]   */
+#define OCFB_PLLDIVCNT_N_SHIFT	9	/* input divide         [15:9]  */
+#define OCFB_PLLDIVCNT_C_SHIFT	16	/* post-scale (clk_pix) [24:16] */
+
+#define OCFB_PLLCTRL_APPLY	0x00000001 /* W1S start; reads 1 while busy */
+#define OCFB_PLLCTRL_LOCKED	0x00000002 /* PLL locked (RO) */
+#define OCFB_PLLCTRL_ERROR	0x00000004 /* recalibration error (RO) */
+
+/* accept a solved pixel clock within this many ppm of the request */
+#define OCFB_PLL_TOL_PPM	10000
+
+struct ocfb_drm {
+	struct drm_device drm;
+	void __iomem *regs;
+	bool big_endian;
+	bool has_pitch;
+	/* programmable pixel-clock PLL (opencores,programmable-pixclk) */
+	bool has_pll;
+	unsigned long pll_refclk;	/* reference (fIN), Hz */
+	u32 pll_vco_min, pll_vco_max;	/* fVCO operating band, Hz */
+	u32 pll_pfd_min, pll_pfd_max;	/* fPFD operating band, Hz */
+	u32 pll_m_min, pll_m_max;	/* feedback (multiply) counter M range */
+	u32 pll_n_min, pll_n_max;	/* input divide counter N range */
+	u32 pll_c_min, pll_c_max;	/* post-scale (output) counter C range */
+	u32 max_pixclk_hz;		/* optional clk_pix ceiling, Hz (0 = none) */
+	u16 pll_m, pll_n, pll_c;	/* divisors last written to PLLDIVCNT */
+	bool pll_programmed;		/* pll_m/n/c hold a live value */
+	struct drm_simple_display_pipe pipe;
+	struct drm_connector connector;
+};
+
+#define drm_to_ocfb(d)	container_of(d, struct ocfb_drm, drm)
+#define pipe_to_ocfb(p)	container_of(p, struct ocfb_drm, pipe)
+
+static inline u32 ocfb_rd(struct ocfb_drm *ocfb, u32 off)
+{
+	return ocfb->big_endian ? ioread32be(ocfb->regs + off)
+				: ioread32(ocfb->regs + off);
+}
+
+static inline void ocfb_wr(struct ocfb_drm *ocfb, u32 off, u32 val)
+{
+	if (ocfb->big_endian)
+		iowrite32be(val, ocfb->regs + off);
+	else
+		iowrite32(val, ocfb->regs + off);
+}
+
+/*
+ * Solve the PLL divisors {M, N, C} for an output pixel clock as close as
+ * possible to @target_hz:
+ *
+ *	fPFD = fIN / N		must lie in [pfd_min, pfd_max]
+ *	fVCO = fIN * M / N	must lie in [vco_min, vco_max]
+ *	fOUT = fVCO / C
+ *
+ * Software only programs the logical divide values; the charge pump and
+ * loop-filter settings are derived in hardware. The smallest-frequency-error
+ * {M, N, C} within OCFB_PLL_TOL_PPM is returned, breaking ties toward the
+ * higher VCO (lowest output jitter). -EINVAL if nothing lands in tolerance.
+ */
+static int ocfb_pll_solve(struct ocfb_drm *ocfb, unsigned long target_hz,
+			  u16 *out_m, u16 *out_n, u16 *out_c,
+			  unsigned long *out_hz)
+{
+	unsigned long fin = ocfb->pll_refclk;
+	unsigned long best_hz = 0, best_vco = 0;
+	u64 best_err = U64_MAX;
+	unsigned int n, m;
+
+	if (!target_hz || !fin)
+		return -EINVAL;
+
+	for (n = ocfb->pll_n_min; n <= ocfb->pll_n_max; n++) {
+		unsigned long pfd = fin / n;
+
+		if (pfd < ocfb->pll_pfd_min || pfd > ocfb->pll_pfd_max)
+			continue;
+
+		for (m = ocfb->pll_m_min; m <= ocfb->pll_m_max; m++) {
+			u64 vco = (u64)fin * m;
+			unsigned long fvco, fout;
+			unsigned int c;
+			u64 err;
+
+			do_div(vco, n);		/* fIN * M / N */
+			fvco = vco;
+			if (fvco < ocfb->pll_vco_min || fvco > ocfb->pll_vco_max)
+				continue;
+
+			c = DIV_ROUND_CLOSEST(fvco, target_hz);
+			c = clamp_t(unsigned int, c, ocfb->pll_c_min,
+				    ocfb->pll_c_max);
+			fout = fvco / c;
+
+			err = (fout > target_hz) ? fout - target_hz
+						 : target_hz - fout;
+			if (err < best_err ||
+			    (err == best_err && fvco > best_vco)) {
+				best_err = err;
+				best_hz = fout;
+				best_vco = fvco;
+				*out_m = m;
+				*out_n = n;
+				*out_c = c;
+			}
+		}
+	}
+
+	if (!best_hz ||
+	    best_err * 1000000ULL > (u64)target_hz * OCFB_PLL_TOL_PPM)
+		return -EINVAL;
+
+	*out_hz = best_hz;
+	return 0;
+}
+
+/*
+ * Reprogram the pixel-clock PLL for @target_hz. The caller must have parked
+ * the pixel domain (CTRL = 0): program the divisors, pulse PLLCTRL.apply, then
+ * wait for the reconfiguration FSM to finish and the PLL to relock. A no-op
+ * when the divisors are unchanged. Runs in the atomic commit tail (process
+ * context), so sleeping while polling is fine.
+ */
+static int ocfb_pll_set(struct ocfb_drm *ocfb, unsigned long target_hz)
+{
+	struct device *dev = ocfb->drm.dev;
+	unsigned long fout;
+	u16 m, n, c;
+	u32 val;
+	int ret;
+
+	ret = ocfb_pll_solve(ocfb, target_hz, &m, &n, &c, &fout);
+	if (ret) {
+		dev_err(dev, "no PLL setting for %lu Hz pixel clock\n",
+			target_hz);
+		return ret;
+	}
+
+	/* nothing to do if this is already the live setting */
+	if (ocfb->pll_programmed &&
+	    m == ocfb->pll_m && n == ocfb->pll_n && c == ocfb->pll_c)
+		return 0;
+
+	/* make sure no earlier reconfiguration is still in flight */
+	ret = read_poll_timeout(ocfb_rd, val, !(val & OCFB_PLLCTRL_APPLY),
+				100, 100000, false, ocfb, OCFB_PLLCTRL);
+	if (ret) {
+		dev_err(dev, "PLL busy before reconfigure (PLLCTRL=0x%08x)\n",
+			val);
+		return ret;
+	}
+
+	ocfb_wr(ocfb, OCFB_PLLDIVCNT,
+		(u32)m << OCFB_PLLDIVCNT_M_SHIFT |
+		(u32)n << OCFB_PLLDIVCNT_N_SHIFT |
+		(u32)c << OCFB_PLLDIVCNT_C_SHIFT);
+	ocfb_wr(ocfb, OCFB_PLLCTRL, OCFB_PLLCTRL_APPLY);
+
+	dev_dbg(dev, "pixel clock %lu Hz (M=%u N=%u C=%u)\n", fout, m, n, c);
+
+	/* apply self-clears when the FSM completes (HW timeout ~21 ms) */
+	ret = read_poll_timeout(ocfb_rd, val, !(val & OCFB_PLLCTRL_APPLY),
+				200, 100000, false, ocfb, OCFB_PLLCTRL);
+	if (ret) {
+		dev_err(dev, "PLL reconfigure timed out (PLLCTRL=0x%08x)\n", val);
+		return ret;
+	}
+	if ((val & OCFB_PLLCTRL_ERROR) || !(val & OCFB_PLLCTRL_LOCKED)) {
+		dev_err(dev, "PLL failed to lock (PLLCTRL=0x%08x)\n", val);
+		return -EIO;
+	}
+
+	ocfb->pll_m = m;
+	ocfb->pll_n = n;
+	ocfb->pll_c = c;
+	ocfb->pll_programmed = true;
+
+	return 0;
+}
+
+/* Read the reference clock and PLL operating bands from the device tree. */
+static int ocfb_pll_of_setup(struct ocfb_drm *ocfb, struct device *dev)
+{
+	struct device_node *np = dev->of_node;
+	struct clk *refclk;
+	u32 band[2];
+	int ret;
+
+	refclk = devm_clk_get_optional_enabled(dev, NULL);
+	if (IS_ERR(refclk))
+		return dev_err_probe(dev, PTR_ERR(refclk),
+				     "cannot get PLL reference clock\n");
+	if (refclk)
+		ocfb->pll_refclk = clk_get_rate(refclk);
+	if (!ocfb->pll_refclk)
+		return dev_err_probe(dev, -EINVAL,
+				     "programmable-pixclk needs a reference clock\n");
+
+	ret = of_property_read_u32_array(np, "opencores,pll-vco-hz", band, 2);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing opencores,pll-vco-hz\n");
+	ocfb->pll_vco_min = band[0];
+	ocfb->pll_vco_max = band[1];
+
+	ret = of_property_read_u32_array(np, "opencores,pll-pfd-hz", band, 2);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing opencores,pll-pfd-hz\n");
+	ocfb->pll_pfd_min = band[0];
+	ocfb->pll_pfd_max = band[1];
+
+	/*
+	 * Integer divide-counter ranges. These are PLL-macro specific (set by
+	 * the counter widths of whatever PLL sits behind the reconfigure CSRs),
+	 * so they come from the device tree rather than being hard-coded.
+	 */
+	ret = of_property_read_u32_array(np, "opencores,pll-m-range", band, 2);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing opencores,pll-m-range\n");
+	ocfb->pll_m_min = band[0];
+	ocfb->pll_m_max = band[1];
+
+	ret = of_property_read_u32_array(np, "opencores,pll-n-range", band, 2);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing opencores,pll-n-range\n");
+	ocfb->pll_n_min = band[0];
+	ocfb->pll_n_max = band[1];
+
+	ret = of_property_read_u32_array(np, "opencores,pll-c-range", band, 2);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing opencores,pll-c-range\n");
+	ocfb->pll_c_min = band[0];
+	ocfb->pll_c_max = band[1];
+
+	/* optional output ceiling (board HDMI TX / timing budget); 0 = none */
+	of_property_read_u32(np, "opencores,max-pixclk-hz", &ocfb->max_pixclk_hz);
+
+	/* N and C are divisors (fIN/N, fVCO/C), so their minimum must be >= 1 */
+	if (ocfb->pll_vco_min > ocfb->pll_vco_max ||
+	    ocfb->pll_pfd_min > ocfb->pll_pfd_max ||
+	    ocfb->pll_m_min > ocfb->pll_m_max ||
+	    ocfb->pll_n_min > ocfb->pll_n_max || !ocfb->pll_n_min ||
+	    ocfb->pll_c_min > ocfb->pll_c_max || !ocfb->pll_c_min)
+		return dev_err_probe(dev, -EINVAL,
+				     "invalid PLL operating limits\n");
+
+	return 0;
+}
+
+/* Map a DRM fourcc to the CTRL colour-depth field. */
+static u32 ocfb_ctrl_color_depth(u32 fourcc)
+{
+	switch (fourcc) {
+	case DRM_FORMAT_RGB565:
+		return OCFB_CTRL_CD16;
+	case DRM_FORMAT_RGB888:
+		return OCFB_CTRL_CD24;
+	case DRM_FORMAT_XRGB8888:
+	default:
+		return OCFB_CTRL_CD32;
+	}
+}
+
+static const u32 ocfb_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_RGB565,
+};
+
+/*
+ * Fixed mode list. The output drives a dumb HDMI transmitter with no
+ * DDC/EDID, so rather than the generic drm_add_modes_noedid() table (whose
+ * 1920x1080 entry carries VESA-DMT negative sync) we advertise an explicit
+ * set with CEA-861 / VESA-DMT timings and the correct sync polarity.
+ * 1920x1080 is the preferred mode. With opencores,programmable-pixclk the PLL
+ * is reprogrammed to each mode's dot clock on mode set; modes whose clock
+ * exceeds the optional max-pixclk-hz are rejected in mode_valid.
+ */
+static const struct drm_display_mode ocfb_modes[] = {
+	/* 1920x1080@60 -- CEA-861 mode 16, preferred */
+	{ DRM_MODE("1920x1080", DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+		   148500, 1920, 2008, 2052, 2200, 0, 1080, 1084, 1089, 1125, 0,
+		   DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC) },
+	/* 1280x720@60 -- CEA-861 mode 4 */
+	{ DRM_MODE("1280x720", DRM_MODE_TYPE_DRIVER,
+		   74250, 1280, 1390, 1430, 1650, 0, 720, 725, 730, 750, 0,
+		   DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC) },
+	/* 1600x1200@60 -- VESA DMT (UXGA) */
+	{ DRM_MODE("1600x1200", DRM_MODE_TYPE_DRIVER,
+		   162000, 1600, 1664, 1856, 2160, 0, 1200, 1201, 1204, 1250, 0,
+		   DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC) },
+	/* 1280x1024@60 -- VESA DMT (SXGA) */
+	{ DRM_MODE("1280x1024", DRM_MODE_TYPE_DRIVER,
+		   108000, 1280, 1328, 1440, 1688, 0, 1024, 1025, 1028, 1066, 0,
+		   DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC) },
+	/* 1024x768@60 -- VESA DMT (XGA) */
+	{ DRM_MODE("1024x768", DRM_MODE_TYPE_DRIVER,
+		   65000, 1024, 1048, 1184, 1344, 0, 768, 771, 777, 806, 0,
+		   DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC) },
+	/* 800x600@60 -- VESA DMT (SVGA) */
+	{ DRM_MODE("800x600", DRM_MODE_TYPE_DRIVER,
+		   40000, 800, 840, 968, 1056, 0, 600, 601, 605, 628, 0,
+		   DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC) },
+	/* 640x480@60 -- VESA DMT (VGA) */
+	{ DRM_MODE("640x480", DRM_MODE_TYPE_DRIVER,
+		   25175, 640, 656, 752, 800, 0, 480, 490, 492, 525, 0,
+		   DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC) },
+};
+
+static int ocfb_connector_get_modes(struct drm_connector *connector)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(ocfb_modes); i++) {
+		struct drm_display_mode *mode;
+
+		mode = drm_mode_duplicate(connector->dev, &ocfb_modes[i]);
+		if (!mode)
+			continue;
+		drm_mode_probed_add(connector, mode);
+	}
+
+	return ARRAY_SIZE(ocfb_modes);
+}
+
+static const struct drm_connector_helper_funcs ocfb_connector_helper_funcs = {
+	.get_modes = ocfb_connector_get_modes,
+};
+
+static const struct drm_connector_funcs ocfb_connector_funcs = {
+	.reset = drm_atomic_helper_connector_reset,
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.destroy = drm_connector_cleanup,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
+
+/* Program the scanout base from the plane's current framebuffer. */
+static void ocfb_set_scanout(struct ocfb_drm *ocfb, struct drm_plane_state *state)
+{
+	struct drm_gem_dma_object *gem;
+
+	if (!state || !state->fb)
+		return;
+
+	gem = drm_fb_dma_get_gem_obj(state->fb, 0);
+	ocfb_wr(ocfb, OCFB_VBARA, lower_32_bits(gem->dma_addr));
+}
+
+static void ocfb_pipe_enable(struct drm_simple_display_pipe *pipe,
+			     struct drm_crtc_state *crtc_state,
+			     struct drm_plane_state *plane_state)
+{
+	struct ocfb_drm *ocfb = pipe_to_ocfb(pipe);
+	struct drm_display_mode *m = &crtc_state->adjusted_mode;
+	struct drm_framebuffer *fb = plane_state->fb;
+	u32 hsw, hbp, vsw, vbp, ctrl;
+
+	/* Disable video while the timing registers are reprogrammed. */
+	ocfb_wr(ocfb, OCFB_CTRL, 0);
+
+	/*
+	 * Reprogram the pixel clock (parked while video is disabled). mode_valid
+	 * already rejected anything the PLL cannot synthesise, so a failure here
+	 * is unexpected; log it -- enable() cannot propagate an error.
+	 */
+	if (ocfb->has_pll &&
+	    ocfb_pll_set(ocfb, (unsigned long)m->crtc_clock * 1000))
+		dev_err(ocfb->drm.dev, "pixel clock %d kHz not set\n",
+			m->crtc_clock);
+
+	hsw = m->crtc_hsync_end - m->crtc_hsync_start;	/* sync width    */
+	hbp = m->crtc_htotal - m->crtc_hsync_end;	/* back porch    */
+	ocfb_wr(ocfb, OCFB_HTIM,
+		(hsw - 1) << 24 | (hbp - 1) << 16 | (m->crtc_hdisplay - 1));
+
+	vsw = m->crtc_vsync_end - m->crtc_vsync_start;
+	vbp = m->crtc_vtotal - m->crtc_vsync_end;
+	ocfb_wr(ocfb, OCFB_VTIM,
+		(vsw - 1) << 24 | (vbp - 1) << 16 | (m->crtc_vdisplay - 1));
+
+	ocfb_wr(ocfb, OCFB_HVLEN,
+		(m->crtc_htotal - 1) << 16 | (m->crtc_vtotal - 1));
+
+	if (ocfb->has_pitch) {
+		u32 pitch = fb->pitches[0] -
+			    m->crtc_hdisplay * fb->format->cpp[0];
+
+		ocfb_wr(ocfb, OCFB_PITCH, pitch);
+	}
+
+	ocfb_set_scanout(ocfb, plane_state);
+
+	ctrl = OCFB_CTRL_VEN | OCFB_CTRL_VBL8 |
+	       ocfb_ctrl_color_depth(fb->format->format);
+	if (!(m->flags & DRM_MODE_FLAG_PHSYNC))
+		ctrl |= OCFB_CTRL_HSL;
+	if (!(m->flags & DRM_MODE_FLAG_PVSYNC))
+		ctrl |= OCFB_CTRL_VSL;
+
+	ocfb_wr(ocfb, OCFB_CTRL, ctrl);
+}
+
+static enum drm_mode_status
+ocfb_pipe_mode_valid(struct drm_simple_display_pipe *pipe,
+		     const struct drm_display_mode *mode)
+{
+	struct ocfb_drm *ocfb = pipe_to_ocfb(pipe);
+	unsigned long target = (unsigned long)mode->clock * 1000;
+	unsigned long fout;
+	u16 m, n, c;
+
+	/* Without a programmable PLL the clock is fixed; accept the mode. */
+	if (!ocfb->has_pll)
+		return MODE_OK;
+
+	if (ocfb->max_pixclk_hz && target > ocfb->max_pixclk_hz)
+		return MODE_CLOCK_HIGH;
+	if (ocfb_pll_solve(ocfb, target, &m, &n, &c, &fout))
+		return MODE_NOCLOCK;
+
+	return MODE_OK;
+}
+
+static void ocfb_pipe_disable(struct drm_simple_display_pipe *pipe)
+{
+	struct ocfb_drm *ocfb = pipe_to_ocfb(pipe);
+
+	ocfb_wr(ocfb, OCFB_CTRL, 0);
+}
+
+static void ocfb_pipe_update(struct drm_simple_display_pipe *pipe,
+			     struct drm_plane_state *old_state)
+{
+	struct ocfb_drm *ocfb = pipe_to_ocfb(pipe);
+
+	ocfb_set_scanout(ocfb, pipe->plane.state);
+}
+
+static const struct drm_simple_display_pipe_funcs ocfb_pipe_funcs = {
+	.mode_valid = ocfb_pipe_mode_valid,
+	.enable = ocfb_pipe_enable,
+	.disable = ocfb_pipe_disable,
+	.update = ocfb_pipe_update,
+};
+
+static const struct drm_mode_config_funcs ocfb_mode_config_funcs = {
+	.fb_create = drm_gem_fb_create,
+	.atomic_check = drm_atomic_helper_check,
+	.atomic_commit = drm_atomic_helper_commit,
+};
+
+DEFINE_DRM_GEM_DMA_FOPS(ocfb_fops);
+
+static const struct drm_driver ocfb_drm_driver = {
+	.driver_features = DRIVER_MODESET | DRIVER_GEM | DRIVER_ATOMIC,
+	.name = "ocfb-drm",
+	.desc = "OpenCores VGA/LCD core (KMS)",
+	.date = "20260614",
+	.major = 1,
+	.minor = 0,
+	.fops = &ocfb_fops,
+	DRM_GEM_DMA_DRIVER_OPS,
+};
+
+static int ocfb_modeset_init(struct ocfb_drm *ocfb)
+{
+	struct drm_device *drm = &ocfb->drm;
+	int ret;
+
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		return ret;
+
+	/* covers the advertised modes: 1920 wide (1080p), 1200 tall (UXGA) */
+	drm->mode_config.min_width = 0;
+	drm->mode_config.min_height = 0;
+	drm->mode_config.max_width = 1920;
+	drm->mode_config.max_height = 1200;
+	drm->mode_config.funcs = &ocfb_mode_config_funcs;
+
+	drm_connector_helper_add(&ocfb->connector,
+				 &ocfb_connector_helper_funcs);
+	ret = drm_connector_init(drm, &ocfb->connector, &ocfb_connector_funcs,
+				 DRM_MODE_CONNECTOR_HDMIA);
+	if (ret)
+		return ret;
+
+	ret = drm_simple_display_pipe_init(drm, &ocfb->pipe, &ocfb_pipe_funcs,
+					   ocfb_formats, ARRAY_SIZE(ocfb_formats),
+					   NULL, &ocfb->connector);
+	if (ret)
+		return ret;
+
+	drm_mode_config_reset(drm);
+
+	return 0;
+}
+
+static int ocfb_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct ocfb_drm *ocfb;
+	struct drm_device *drm;
+	int ret;
+
+	ocfb = devm_drm_dev_alloc(dev, &ocfb_drm_driver, struct ocfb_drm, drm);
+	if (IS_ERR(ocfb))
+		return PTR_ERR(ocfb);
+	drm = &ocfb->drm;
+
+	ocfb->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(ocfb->regs))
+		return PTR_ERR(ocfb->regs);
+
+	/* VBAR is 32-bit; all of this board's DDR is below 4 GiB anyway. */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	/*
+	 * Optional: a "memory-region" dma-pool the scanout buffer is allocated
+	 * from. Absent -> GEM-DMA falls back to the system DMA allocator.
+	 */
+	ret = of_reserved_mem_device_init(dev);
+	if (ret && ret != -ENODEV)
+		return dev_err_probe(dev, ret, "failed to init reserved memory\n");
+
+	ocfb->has_pitch = of_property_read_bool(dev->of_node,
+						"opencores,has-pitch");
+
+	ocfb->has_pll = of_property_read_bool(dev->of_node,
+					      "opencores,programmable-pixclk");
+	if (ocfb->has_pll) {
+		ret = ocfb_pll_of_setup(ocfb, dev);
+		if (ret)
+			return ret;
+	}
+
+	/*
+	 * Register byte order. The OpenCores core can be synthesised either
+	 * way and there is no robust way to probe it at runtime -- a faithful
+	 * scratch register round-trips through any consistent accessor, so a
+	 * write/read-back test detects nothing. Honour the generic "big-endian"
+	 * DT property and default to little-endian otherwise.
+	 */
+	ocfb->big_endian = of_device_is_big_endian(dev->of_node);
+	ocfb_wr(ocfb, OCFB_CTRL, 0);	/* keep video disabled until modeset */
+
+	ret = ocfb_modeset_init(ocfb);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to init modeset\n");
+
+	ret = drm_dev_register(drm, 0);
+	if (ret)
+		return ret;
+
+	drm_fbdev_dma_setup(drm, 16);
+
+	return 0;
+}
+
+static void ocfb_remove(struct platform_device *pdev)
+{
+	struct drm_device *drm = platform_get_drvdata(pdev);
+
+	drm_dev_unregister(drm);
+	drm_atomic_helper_shutdown(drm);
+}
+
+static void ocfb_shutdown(struct platform_device *pdev)
+{
+	drm_atomic_helper_shutdown(platform_get_drvdata(pdev));
+}
+
+static const struct of_device_id ocfb_of_match[] = {
+	{ .compatible = "opencores,ocfb" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ocfb_of_match);
+
+static struct platform_driver ocfb_platform_driver = {
+	.probe = ocfb_probe,
+	.remove_new = ocfb_remove,
+	.shutdown = ocfb_shutdown,
+	.driver = {
+		.name = "ocfb-drm",
+		.of_match_table = ocfb_of_match,
+	},
+};
+
+drm_module_platform_driver(ocfb_platform_driver);
+
+MODULE_AUTHOR("Steffen Persvold <spersvold@gmail.com>");
+MODULE_DESCRIPTION("OpenCores VGA/LCD 2.0 DRM/KMS driver");
+MODULE_LICENSE("GPL");
