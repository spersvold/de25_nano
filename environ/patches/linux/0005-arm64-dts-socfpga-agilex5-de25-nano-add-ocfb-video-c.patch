From 9d46a45c8bae67d9b14e219031b2b5b23b493238 Mon Sep 17 00:00:00 2001
From: Steffen Persvold <spersvold@gmail.com>
Date: Sun, 14 Jun 2026 11:37:25 +0200
Subject: [PATCH 5/5] arm64: dts: socfpga: agilex5: de25-nano: add ocfb video
 controller

Wire up the FPGA video controller (opencores,ocfb -- the vctrl RTL block)
on the lightweight HPS->FPGA bridge: CSR window at 0x2000_0000, a 64 MiB
no-map shared-dma-pool the DRM driver allocates scanout buffers from
(placed dynamically), the 50 MHz pixel-clock PLL reference, the Agilex 5
HVIO IOPLL operating bands and M/N/C counter ranges, and the 165 MHz
output ceiling.

Signed-off-by: Steffen Persvold <spersvold@gmail.com>
---
 .../dts/intel/socfpga_agilex5_de25_nano.dts   | 63 +++++++++++++++++++
 1 file changed, 63 insertions(+)

diff --git a/arch/arm64/boot/dts/intel/socfpga_agilex5_de25_nano.dts b/arch/arm64/boot/dts/intel/socfpga_agilex5_de25_nano.dts
index e1acbfc7..f9945e98 100644
--- a/arch/arm64/boot/dts/intel/socfpga_agilex5_de25_nano.dts
+++ b/arch/arm64/boot/dts/intel/socfpga_agilex5_de25_nano.dts
@@ -38,6 +38,69 @@ memory {
 	};
 };
 
+/ {
+	/*
+	 * Reference clock (fIN) for the FPGA HDMI pixel-clock PLL: the fixed
+	 * 50 MHz board oscillator (CLOCK1_50) feeding the Agilex 5 HVIO IOPLL.
+	 * The HPS has no clock controller for it, so model it as a fixed-clock.
+	 */
+	hdmi_pll_refclk: hdmi-pll-refclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <50000000>;
+	};
+};
+
+&soc {
+	/*
+	 * "vctrl" video controller (OpenCores VGA/LCD register-compatible),
+	 * reached through the lightweight HPS->FPGA bridge (lwh2f base
+	 * 0x2000_0000, CSR block at offset 0 per lw_ctrl_bridge.sv).
+	 *
+	 * reg[0] = 4 KiB CSR window. The ocfb DRM driver allocates GEM-DMA
+	 * scanout buffers and programs VBAR (0x14, base) and VSIZ (0x18, size)
+	 * that drive vctrl_axim's reads. Those reads reach DRAM via the
+	 * FPGA-to-SDRAM bridge behind the SMMU (iommus below), so VBAR carries an
+	 * IOVA and no reserved carveout is needed.
+	 */
+	framebuffer0: framebuffer@20000000 {
+		compatible = "opencores,ocfb";
+		reg = <0x20000000 0x1000>;
+		/* vctrl vsync -> fpga2hps_interrupt_irq0[0] -> GIC SPI 17 */
+		interrupts = <GIC_SPI 17 IRQ_TYPE_LEVEL_HIGH>;
+		/*
+		 * Scanout DMA goes through the SMMU. The f2sdram master presents
+		 * AxMMUSID = 0x10, AxMMUSECSID = 0 (non-secure), so bind this device
+		 * to that non-secure stream. dma_alloc then returns an IOVA and VBAR
+		 * carries it directly -- the SMMU does the IOVA->physical mapping, so
+		 * vbar-offset stays 0 and no reserved-memory carveout is needed.
+		 */
+		iommus = <&smmu 0x10>;
+		opencores,vbar-offset = <0>;
+		/* this vctrl implements the optional 0x20 pitch register and
+		 * hardware scan doubling (control register bit 16) */
+		opencores,has-pitch;
+		opencores,has-doublescan;
+		/*
+		 * Runtime-programmable pixel clock (PLLDIVCNT 0x100 / PLLCTRL
+		 * 0x104 + the hdmi_pll_recfg FSM). clocks is the 50 MHz fIN
+		 * reference; the bands and M/N/C counter ranges are the Agilex 5
+		 * HVIO IOPLL limits (fVCO 600-3200 MHz, fPFD 10-325 MHz;
+		 * M 4-320, N 1-110, C 1-510).
+		 */
+		opencores,programmable-pixclk;
+		clocks = <&hdmi_pll_refclk>;
+		opencores,pll-vco-hz = <600000000 3200000000>;
+		opencores,pll-pfd-hz = <10000000 325000000>;
+		opencores,pll-m-range = <4 320>;
+		opencores,pll-n-range = <1 110>;
+		opencores,pll-c-range = <1 510>;
+		/* HDMI TX / output timing ceiling (covers up to UXGA) */
+		opencores,max-pixclk-hz = <165000000>;
+		status = "okay";
+	};
+};
+
 &gpio1 {
 	status = "okay";
 };
-- 
