From c57110429ad6505d20ceeb624d5ba4c6093a461f Mon Sep 17 00:00:00 2001
From: Steffen Persvold <spersvold@gmail.com>
Date: Sun, 14 Jun 2026 11:37:25 +0200
Subject: [PATCH] arm64: dts: socfpga: agilex5: de25-nano: add ocfb video
 controller

Wire up the FPGA video controller (opencores,ocfb -- the vctrl RTL block)
on the lightweight HPS->FPGA bridge: CSR window at 0x2000_0000, a 64 MiB
no-map shared-dma-pool the DRM driver allocates scanout buffers from
(placed dynamically), the 50 MHz pixel-clock PLL reference, the Agilex 5
HVIO IOPLL operating bands and M/N/C counter ranges, and the 165 MHz
output ceiling.

Enable copy-on-flip into FPGA-local VRAM: the 1 GiB VRAM aperture at
0x4000_0000 (reg "vram") and the vctrl_dma command engine (reg "dma" at
0x2000_1000) alongside the CSR window. The host framebuffer pool stays in
the shared-dma-pool; the engine copies each flip into two scanout buffers
carved from the base of the VRAM aperture and scanout reads from there.
opencores,vram-base is 0 (the VRAM crossbar port is zero-based). Both
interrupts are declared -- vsync (fpga2hps_interrupt_irq0[0] -> GIC SPI 17)
and the vctrl_dma done interrupt (fpga2hps_interrupt_irq0[1] -> GIC SPI 18)
-- so the driver completes flips asynchronously from the DMA-done interrupt;
dropping the second interrupt falls back to synchronous polled flips.

Signed-off-by: Steffen Persvold <spersvold@gmail.com>
---
 .../dts/intel/socfpga_agilex5_de25_nano.dts   | 122 ++++++++++++++++++
 1 file changed, 122 insertions(+)

diff --git a/arch/arm64/boot/dts/intel/socfpga_agilex5_de25_nano.dts b/arch/arm64/boot/dts/intel/socfpga_agilex5_de25_nano.dts
index e1acbfc7..a6e4947b 100644
--- a/arch/arm64/boot/dts/intel/socfpga_agilex5_de25_nano.dts
+++ b/arch/arm64/boot/dts/intel/socfpga_agilex5_de25_nano.dts
@@ -38,6 +38,128 @@ memory {
 	};
 };
 
+/ {
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * Framebuffer pool in LPDDR4, referenced by the framebuffer node's
+		 * memory-region: the DRM driver allocates all its GEM-DMA / dumb
+		 * scanout buffers here. Sized for several full-screen buffers --
+		 * GBM/EGL clients double/triple-buffer (plus a depth buffer) and
+		 * fbcon holds one, ~8 MiB each at 1920x1080x32 -- hence 64 MiB.
+		 *
+		 * Dynamically placed (size, not reg) so the kernel picks a free
+		 * range; all of this board's DDR is the 1 GiB window
+		 * 0x8000_0000-0xBFFF_FFFF (< 4 GiB), so any placement is reachable by
+		 * the 32-bit VBAR. no-map keeps it out of the cacheable linear map;
+		 * the DMA layer memremaps it write-combining, which suits
+		 * vctrl_axim's non-coherent (ARCACHE=Non-cacheable) FPGA->HPS reads
+		 * -- so do NOT mark it dma-coherent.
+		 */
+		fb_reserved: framebuffer {
+			compatible = "shared-dma-pool";
+			no-map;
+			size = <0x0 0x04000000>;
+			alignment = <0x0 0x00100000>;
+		};
+	};
+};
+
+/ {
+	/*
+	 * Reference clock (fIN) for the FPGA HDMI pixel-clock PLL: the fixed
+	 * 50 MHz board oscillator (CLOCK1_50) feeding the Agilex 5 HVIO IOPLL.
+	 * The HPS has no clock controller for it, so model it as a fixed-clock.
+	 */
+	hdmi_pll_refclk: hdmi-pll-refclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <50000000>;
+	};
+};
+
+&soc {
+	/*
+	 * "vctrl" video controller (OpenCores VGA/LCD register-compatible),
+	 * reached through the lightweight HPS->FPGA bridge (lwh2f base
+	 * 0x2000_0000, CSR block at offset 0 per lw_ctrl_bridge.sv).
+	 *
+	 * Copy-on-flip: userspace renders into GEM-DMA framebuffers in host DRAM
+	 * (the fb_reserved pool); on every flip the vctrl_dma command engine
+	 * copies the framebuffer into one of two private scanout buffers in
+	 * FPGA-local LPDDR4 VRAM, and the scanout master reads from VRAM -- so
+	 * scanout reads never contend on the host-DRAM channel.
+	 *
+	 *   reg[0] "csr"  = 4 KiB vctrl CSR window (lwh2f offset 0).
+	 *   reg[1] "vram" = VRAM aperture: the host-visible h2f window onto the
+	 *                   FPGA-local DRAM the engine copies into. 1 GiB at
+	 *                   0x4000_0000. The driver carves two scanout buffers out
+	 *                   of the base of it (sized for the largest mode) and
+	 *                   points VBAR at them via opencores,vram-base; the rest
+	 *                   is spare.
+	 *   reg[2] "dma"  = vctrl_dma command CSRs (lwh2f offset 0x1000).
+	 *
+	 * The scanout read and DMA-write masters address VRAM zero-based (the VRAM
+	 * crossbar port is zero-based), so opencores,vram-base is 0.
+	 */
+	framebuffer0: framebuffer@20000000 {
+		compatible = "opencores,ocfb";
+		reg = <0x20000000 0x00001000>,	/* csr  */
+		      <0x40000000 0x40000000>,	/* vram = 1 GiB FPGA-local DRAM */
+		      <0x20001000 0x00001000>;	/* dma  */
+		reg-names = "csr", "vram", "dma";
+		/*
+		 * [0] vctrl vsync    -> fpga2hps_interrupt_irq0[0] -> GIC SPI 17
+		 * [1] vctrl_dma done -> fpga2hps_interrupt_irq0[1] -> GIC SPI 18
+		 * (irq0[N] = SPI 17+N). With the DMA-done interrupt present the driver
+		 * completes flips from it (asynchronous); drop the second entry to fall
+		 * back to polling the fence (synchronous).
+		 */
+		interrupts = <GIC_SPI 17 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>;
+		memory-region = <&fb_reserved>;
+		/*
+		 * FPGA-side base of the VRAM aperture as seen by the scanout read
+		 * master (VBAR) and the DMA write master (copy destination). The VRAM
+		 * crossbar port is zero-based, so this is 0.
+		 */
+		opencores,vram-base = <0>;
+		/*
+		 * Translates a host buffer's CPU-physical DMA address into the read
+		 * master's address space: src = dma_addr - vbar-offset. The vctrl_dma
+		 * read master reaches host DRAM through the FPGA-to-SDRAM bridge's
+		 * sdram_2G window, based at 0x8000_0000 -- the same base the MPU sees
+		 * -- so it is 1:1 and the offset is 0. (For direct scanout, without the
+		 * DMA engine, the same offset translates the VBAR scanout base.)
+		 */
+		opencores,vbar-offset = <0>;
+		/* this vctrl implements the optional 0x20 pitch register and
+		 * hardware scan doubling (control register bit 16) */
+		opencores,has-pitch;
+		opencores,has-doublescan;
+		/*
+		 * Runtime-programmable pixel clock (PLLDIVCNT 0x100 / PLLCTRL
+		 * 0x104 + the hdmi_pll_recfg FSM). clocks is the 50 MHz fIN
+		 * reference; the bands and M/N/C counter ranges are the Agilex 5
+		 * HVIO IOPLL limits (fVCO 600-3200 MHz, fPFD 10-325 MHz;
+		 * M 4-320, N 1-110, C 1-510).
+		 */
+		opencores,programmable-pixclk;
+		clocks = <&hdmi_pll_refclk>;
+		opencores,pll-vco-hz = <600000000 3200000000>;
+		opencores,pll-pfd-hz = <10000000 325000000>;
+		opencores,pll-m-range = <4 320>;
+		opencores,pll-n-range = <1 110>;
+		opencores,pll-c-range = <1 510>;
+		/* HDMI TX / output timing ceiling (covers up to UXGA) */
+		opencores,max-pixclk-hz = <165000000>;
+		status = "okay";
+	};
+};
+
 &gpio1 {
 	status = "okay";
 };
-- 
2.40.1

