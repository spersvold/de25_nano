# OpenCores VGA/LCD core: build the DRM/KMS driver (ocfb-drm) instead of the
# legacy fbdev driver. The DRM core is built in so the console comes up at boot
# without relying on module autoload; DRM_OCFB=y then forces FB_OPENCORES off
# through its Kconfig dependency, the same way DRM_SIMPLEDRM supersedes
# FB_SIMPLE.
CONFIG_DRM=y
CONFIG_DRM_OCFB=y
