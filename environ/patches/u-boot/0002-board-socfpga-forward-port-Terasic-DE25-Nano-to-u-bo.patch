--- a/arch/arm/dts/socfpga_agilex5_de25_nano.dts
+++ b/arch/arm/dts/socfpga_agilex5_de25_nano.dts
@@ -47,12 +47,14 @@
 	status = "okay";
 };
 
-&combophy0 {
-	status = "okay";
-};
-
 &uart1 {
 	status = "okay";
+	/*
+	 * The base SoC dtsi gives this hint to uart0 but not uart1; without it
+	 * u-boot proper's ns16550 driver mis-resolves the L4_SP clock and the
+	 * baud divisor is ~4x off (garbage console). 100 MHz = L4_SP_CLK.
+	 */
+	clock-frequency = <100000000>;
 	bootph-all;
 };
 
